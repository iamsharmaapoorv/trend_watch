TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional overrides (defaults shown). See config.py.
# Timeframes per index: any of 5,15
# TREND_WATCH_ENABLED_NIFTY=5,15
# TREND_WATCH_ENABLED_BANKNIFTY=5,15
# Per pairing: TREND_WATCH_<SETTING>_<INDEX>_<MINUTES>
# TREND_WATCH_MIN_STREAK_NIFTY_5=5
# TREND_WATCH_MIN_STREAK_NIFTY_15=4
# TREND_WATCH_MIN_STREAK_BANKNIFTY_5=5
# TREND_WATCH_MIN_STREAK_BANKNIFTY_15=5
# TREND_WATCH_MIN_MOVE_NIFTY_5=0.30
# TREND_WATCH_MIN_MOVE_NIFTY_15=0.35
# TREND_WATCH_MIN_MOVE_BANKNIFTY_5=0.39
# TREND_WATCH_MIN_MOVE_BANKNIFTY_15=0.455
# Hold in candles; "none" = no time limit, trail the stop
# TREND_WATCH_HOLD_CANDLES_NIFTY_5=6
# TREND_WATCH_HOLD_CANDLES_NIFTY_15=none
# TREND_WATCH_HOLD_CANDLES_BANKNIFTY_5=3
# TREND_WATCH_HOLD_CANDLES_BANKNIFTY_15=4
# TREND_WATCH_PAPER=1
